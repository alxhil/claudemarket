# Copy this file to ".env" and fill in your values.

# Bot token — needed to READ messages (Discord Developer Portal > your app > Bot).
DISCORD_BOT_TOKEN=your-bot-token-here

# Incoming webhook URL for the channel — used to POST the replies.
# Channel > Edit Channel > Integrations > Webhooks > New Webhook > Copy URL.
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/XXXX/YYYY

# Optional: enables live betting odds in !soccer.
# Free key (500 req/mo) from https://the-odds-api.com/  -> Get API Key.
ODDS_API_KEY=

# Optional overrides.
COMMAND_PREFIX=!price
WEBHOOK_USERNAME=Market Bot
