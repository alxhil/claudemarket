# Copy this file to ".env" and fill in your values.

# Bot token — the only required secret. Used to read commands and post
# replies in the same channel (Discord Developer Portal > your app > Bot).
DISCORD_BOT_TOKEN=your-bot-token-here

# DISCORD_WEBHOOK_URL is no longer used — the bot now replies via the gateway
# in whichever channel the command was sent. Safe to leave unset.
# DISCORD_WEBHOOK_URL=

# Optional: enables live betting odds in !soccer.
# Free key (500 req/mo) from https://the-odds-api.com/  -> Get API Key.
ODDS_API_KEY=

# Optional overrides.
COMMAND_PREFIX=!price
WEBHOOK_USERNAME=Market Bot
